{
  "name": "Full Page Screen Capture",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Screen capture your current page in entirety and reliably!",
  "action": {
    "default_icon": "icon-999.png",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16-999.png",
    "48": "icon48-999.png",
    "128": "icon128-999.png"
  }
}

